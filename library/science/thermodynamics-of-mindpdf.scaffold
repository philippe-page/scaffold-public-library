        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Deep Sleep",
        "type": "Concept",
        "description": "A specific brain state characterized by distinct hierarchical organization and irreversibility patterns, studied in non-human primates to contrast with awake and anaesthetized states.",
        "tags": [],
        "created": "2026-05-29T23:29:35.249Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Watching Movies",
        "type": "Concept",
        "description": "A specific brain state or activity described as being perched between the resting state and active cognition, used to study hierarchical brain organization.",
        "tags": [],
        "created": "2026-05-29T23:30:21.090Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Whole-brain Models",
        "type": "Concept",
        "description": "Mechanistic models built to explain underlying data of brain dynamics, providing insights into information flow and hierarchical organization beyond simple irreversibility quantification.",
        "tags": [],
        "created": "2026-05-29T23:30:21.219Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Human Connectome Project",
        "type": "Organization",
        "description": "A large-scale neuroimaging project that provided data from over 1000 participants, used in studies applying TENET to analyze brain states like resting state and cognitive tasks.",
        "tags": [],
        "created": "2026-05-29T23:30:21.349Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Deep Learning",
        "type": "Concept",
        "description": "A machine learning technique used within the TENET framework to train on time series data and classify irreversibility levels in brain signals.",
        "tags": [],
        "created": "2026-05-29T23:30:21.482Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Mind Wandering",
        "type": "Concept",
        "description": "A mental state associated with the resting state, characterized by spontaneous, self-generated thought, often contrasted with the engaging experience of watching naturalistic films.",
        "tags": [],
        "created": "2026-05-29T23:30:59.652Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "7 Tesla MRI Scanner",
        "type": "Tool",
        "description": "A high-field magnetic resonance imaging device used to acquire high-resolution brain data from participants while they watched naturalistic movies, rested, or performed cognitive tasks.",
        "tags": [],
        "created": "2026-05-29T23:30:59.785Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Naturalistic Movies",
        "type": "Concept",
        "description": "Multimodal film stimuli used in neuroscience research as an alternative to resting state, proposed to offer higher test-retest reliability and a distinct subjective experience compared to mind wandering or difficult tasks.",
        "tags": [],
        "created": "2026-05-29T23:30:59.916Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Test-Retest Reliability",
        "type": "Concept",
        "description": "A measure of consistency in results when a test is repeated, noted to be higher when using naturalistic films compared to resting state protocols in clinical and younger populations.",
        "tags": [],
        "created": "2026-05-29T23:31:00.051Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Parietal Regions",
        "type": "Concept",
        "description": "Brain regions involved in the causal generators of movie watching, working in conjunction with the prefrontal cortex.",
