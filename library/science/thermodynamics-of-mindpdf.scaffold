    "entities": [
      {
        "name": "The Thermodynamics of Mind",
        "type": "Concept",
        "description": "A theoretical framework proposed to quantify hierarchical brain orchestration and its underlying mechanisms using thermodynamic principles.",
        "tags": [],
        "created": "2026-05-29T23:17:57.210Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Morten L. Kringelbach",
        "type": "Person",
        "description": "Researcher and co-author of 'The Thermodynamics of Mind' paper, focusing on brain dynamics and thermodynamics.",
        "tags": [],
        "created": "2026-05-29T23:18:04.985Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Yonatan Sanz Perl",
        "type": "Person",
        "description": "Researcher and co-author of 'The Thermodynamics of Mind' paper.",
        "tags": [],
        "created": "2026-05-29T23:18:05.116Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Gustavo Deco",
        "type": "Person",
        "description": "Researcher and co-author of 'The Thermodynamics of Mind' paper.",
        "tags": [],
        "created": "2026-05-29T23:18:05.241Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Brain Hierarchy",
        "type": "Concept",
        "description": "The hierarchical organization of the brain that facilitates fast information transfer and processing at low metabolic cost, characterized by the asymmetry of information flow.",
        "tags": [],
        "created": "2026-05-29T23:18:05.375Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Thermodynamics",
        "type": "Concept",
        "description": "A physical theory of universal content used to characterize hierarchy in complex systems, including the brain, by analyzing energy and information flow.",
        "tags": [],
        "created": "2026-05-29T23:18:05.501Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Irreversibility",
        "type": "Concept",
        "description": "A key thermodynamic concept used to reveal the asymmetry of brain information flow and the 'arrow of time' in neural processes.",
        "tags": [],
        "created": "2026-05-29T23:18:05.625Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Arrow of Time",
        "type": "Concept",
        "description": "A concept linked to irreversibility that helps reveal the asymmetry of information flow in the brain's hierarchical organization.",
        "tags": [],
        "created": "2026-05-29T23:18:05.754Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Whole-brain Modelling",
        "type": "Tool",
        "description": "A computational approach combined with thermodynamics to reveal causal insights into the orchestration of cognition.",
        "tags": [],
        "created": "2026-05-29T23:18:05.881Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Cognition Orchestration",
        "type": "Concept",
        "description": "The efficient coordination of distributed computation across space and time in the brain to enable survival and thriving.",
        "tags": [],
        "created": "2026-05-29T23:18:06.005Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Metabolic Cost",
        "type": "Concept",
        "description": "The energy expenditure required for brain processing, which the brain aims to minimize while maintaining efficient computation.",
        "tags": [],
        "created": "2026-05-29T23:18:06.128Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Information Flow Asymmetry",
        "type": "Concept",
        "description": "The uneven directionality of information transfer in the brain, used as a metric to estimate brain hierarchy.",
        "tags": [],
        "created": "2026-05-29T23:18:06.253Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Neuron",
        "type": "Concept",
        "description": "Basic computational unit of the brain that carries out flexible, time-critical computations for survival, despite slower signal transmission speeds compared to computers.",
        "tags": [],
        "created": "2026-05-29T23:18:46.542Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Synaptic Junction",
        "type": "Concept",
        "description": "The connection point between neurons where electrical signals are converted to chemical signals and back, introducing a delay in information transfer.",
        "tags": [],
        "created": "2026-05-29T23:18:46.696Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Electrical Signal",
        "type": "Concept",
        "description": "The form of signal propagation within a neuron, which is converted to a chemical signal at the synapse.",
        "tags": [],
        "created": "2026-05-29T23:18:46.820Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Chemical Signal",
        "type": "Concept",
        "description": "The form of signal transmission across the synaptic junction, resulting from the conversion of electrical signals.",
        "tags": [],
        "created": "2026-05-29T23:18:46.944Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Computers",
        "type": "Concept",
        "description": "Electronic devices used as a benchmark for information transfer speed, which are orders of magnitude faster than neuronal transmission but often less effective at solving difficult problems.",
        "tags": [],
        "created": "2026-05-29T23:18:47.069Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Hierarchical Architecture",
        "type": "Concept",
        "description": "The structural organization of the mammalian brain that enables nested recursive circuits for processing sensory input and higher-level computation at various spatio-temporal levels.",
        "tags": [],
        "created": "2026-05-29T23:18:47.192Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Nested Recursive Circuits",
        "type": "Concept",
        "description": "Circuit structures within the hierarchical brain architecture that allow for computation at various spatio-temporal levels.",
        "tags": [],
        "created": "2026-05-29T23:18:47.316Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Brain Anatomy",
        "type": "Concept",
        "description": "The physical structure of the brain that primarily shapes information flow, analogous to a road network for traffic.",
        "tags": [],
        "created": "2026-05-29T23:18:47.439Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Neurotransmission",
        "type": "Concept",
        "description": "The process of signal transmission between neurons that provides flexibility in sculpting information flow beyond what is dictated by brain anatomy alone.",
        "tags": [],
        "created": "2026-05-29T23:18:47.563Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Information Segregation and Integration",
        "type": "Concept",
        "description": "The capability facilitated by hierarchical brain processing to separate and combine information as needed for time-critical computations.",
        "tags": [],
        "created": "2026-05-29T23:18:47.686Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Wakefulness",
        "type": "Concept",
        "description": "A specific brain state in which hierarchical processing and orchestration occur, distinct from sleep.",
        "tags": [],
        "created": "2026-05-29T23:18:47.814Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Sleep",
        "type": "Concept",
        "description": "A specific brain state in which hierarchical processing and orchestration occur, distinct from wakefulness.",
        "tags": [],
        "created": "2026-05-29T23:18:47.948Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Predictive Coding",
        "type": "Concept",
        "description": "An influential theory of brain function that models perception as a hierarchical process of predicting sensory input and minimizing prediction errors.",
        "tags": [],
        "created": "2026-05-29T23:19:29.246Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Hierarchical Core-Periphery Principles",
        "type": "Concept",
        "description": "A theoretical framework describing brain organization where a stable core interacts with a dynamic periphery to facilitate information processing.",
        "tags": [],
        "created": "2026-05-29T23:19:29.395Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Free-Energy Principles",
        "type": "Concept",
        "description": "A principle of the Bayesian brain suggesting that biological systems act to minimize free energy, effectively reducing surprise or prediction error.",
        "tags": [],
        "created": "2026-05-29T23:19:29.517Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Bayesian Brain",
        "type": "Concept",
        "description": "A theoretical model of the brain that uses Bayesian inference to process sensory information and update beliefs about the world.",
        "tags": [],
        "created": "2026-05-29T23:19:29.642Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Whole-brain Dynamics",
        "type": "Concept",
        "description": "The continuously evolving patterns of activity across the entire brain network, characterized by condition-dependent self-organization.",
        "tags": [],
        "created": "2026-05-29T23:19:29.765Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Brain States",
        "type": "Concept",
        "description": "Distinct configurations of whole-brain network activity, including stable, semistable, and transient arrangements, which are difficult to define universally.",
        "tags": [],
        "created": "2026-05-29T23:19:29.888Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Self-organisation",
        "type": "Concept",
        "description": "The process by which whole-brain networks spontaneously form stable, semistable, or transient arrangements depending on conditions.",
        "tags": [],
        "created": "2026-05-29T23:19:30.013Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Fluctuation–dissipation Theorem",
        "type": "Concept",
        "description": "A central theorem in statistical thermodynamics used to predict nonequilibrium fluctuations, such as the irreversible dissipation of energy into heat from reversible fluctuations in thermal equilibrium.",
        "tags": [],
        "created": "2026-05-29T23:19:30.135Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Statistical Thermodynamics",
        "type": "Concept",
        "description": "A branch of physics that applies probability theory to the study of the thermodynamic behavior of systems composed of a large number of particles.",
        "tags": [],
        "created": "2026-05-29T23:19:30.260Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Institució Catalana de la Recerca i Estudis Avançats",
        "type": "Organization",
        "description": "A research institution located in Barcelona, Spain, associated with the authors of the paper.",
        "tags": [],
        "created": "2026-05-29T23:19:34.329Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Barcelona",
        "type": "Location",
        "description": "A city in Spain where the Institució Catalana de la Recerca i Estudis Avançats is located.",
        "tags": [],
        "created": "2026-05-29T23:19:34.459Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Trends in Cognitive Sciences",
        "type": "Product",
        "description": "The scientific journal in which 'The Thermodynamics of Mind' paper was published in June 2024.",
        "tags": [],
        "created": "2026-05-29T23:19:34.597Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Nonequilibrium Thermodynamics",
        "type": "Concept",
        "description": "A branch of thermodynamics that quantifies the asymmetry of information flow by estimating the reversibility and irreversibility of processes over time in physical and biological systems.",
        "tags": [],
        "created": "2026-05-29T23:20:18.656Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Clive Granger",
        "type": "Person",
        "description": "An econometrician who developed the method of Granger causality for testing the predictive utility of one time series for another.",
        "tags": [],
        "created": "2026-05-29T23:20:22.649Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Granger Causality",
        "type": "Concept",
        "description": "A statistical method developed by Clive Granger used to test how useful one time series is for forecasting another, measuring temporal correlation rather than direct causality.",
        "tags": [],
        "created": "2026-05-29T23:20:22.782Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Partially Ordered Set",
        "type": "Concept",
        "description": "A mathematical definition from order theory used to define hierarchy, relying on the structural relationships within a set rather than simple linear ordering.",
        "tags": [],
        "created": "2026-05-29T23:20:22.910Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Order Theory",
        "type": "Concept",
        "description": "A branch of mathematics that investigates intuitive notions of ordering and binary relations, providing the foundation for concepts like the partially ordered set.",
        "tags": [],
        "created": "2026-05-29T23:20:23.039Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Generative Mechanisms",
        "type": "Concept",
        "description": "Underlying processes that drive the temporal evolution of a system, which can be quantified by building models and manipulating elements to investigate causal influences.",
        "tags": [],
        "created": "2026-05-29T23:20:23.166Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Functional Hierarchy",
        "type": "Concept",
        "description": "The hierarchical organization of brain function determined by the asymmetry of information flow, analogous to organizational structures in enterprises.",
        "tags": [],
        "created": "2026-05-29T23:20:23.296Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Second Law of Thermodynamics",
        "type": "Concept",
        "description": "A fundamental principle of physics stating that the total entropy of an isolated system can never decrease over time, explaining the irreversibility of natural processes like a broken glass not reassembling itself.",
        "tags": [],
        "created": "2026-05-29T23:21:02.955Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Power Law",
        "type": "Concept",
        "description": "A mathematical relationship between two quantities where one varies as a power of the other, often indicating scale-free systems and critical states in complex networks.",
        "tags": [],
        "created": "2026-05-29T23:21:03.088Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Scale-free System",
        "type": "Concept",
        "description": "A system whose distribution of connections follows a power law, characterized by the presence of hubs with many connections and many nodes with few connections.",
        "tags": [],
        "created": "2026-05-29T23:21:03.213Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Self-organised Criticality",
        "type": "Concept",
        "description": "A property of dynamical systems that have a critical point as an attractor, allowing the system to naturally evolve to a critical state without fine-tuning, often associated with robustness to random failures.",
        "tags": [],
        "created": "2026-05-29T23:21:03.339Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "fMRI",
        "type": "Tool",
        "description": "Functional Magnetic Resonance Imaging, a whole-brain neuroimaging technique used to model brain dynamics by measuring brain activity.",
        "tags": [],
        "created": "2026-05-29T23:21:42.248Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Magnetoencephalography",
        "type": "Tool",
        "description": "A neuroimaging technique for mapping brain activity by recording magnetic fields produced by electrical currents occurring naturally in the brain.",
        "tags": [],
        "created": "2026-05-29T23:21:42.397Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Anatomical Connectivity",
        "type": "Concept",
        "description": "The physical structural connections between different brain regions, used as the basis for constructing whole-brain models.",
        "tags": [],
        "created": "2026-05-29T23:21:42.522Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Local Dynamics Model",
        "type": "Concept",
        "description": "A computational model representing the activity within specific anatomically defined brain regions, which is fitted to neuroimaging time series in whole-brain modelling.",
        "tags": [],
        "created": "2026-05-29T23:21:42.647Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Set-Subset Relations",
        "type": "Concept",
        "description": "Mathematical relations describing how elements of a set are organized into subsets, used to characterize hierarchical structures in thermodynamic systems.",
        "tags": [],
        "created": "2026-05-29T23:21:42.774Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Dissipative Mechanisms",
        "type": "Concept",
        "description": "Processes in open thermodynamic systems where energy is dissipated, revealing underlying causal structures and hier Across spatiotemporal scales when probed exhaustively.",
        "tags": [],
        "created": "2026-05-29T23:21:42.911Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Living Systems",
        "type": "Concept",
        "description": "Biological entities that function as thermodynamic open systems exhibiting self-organised behaviour and hierarchical organization.",
        "tags": [],
        "created": "2026-05-29T23:21:43.036Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Reversible Process",
        "type": "Concept",
        "description": "A thermodynamic process that does not produce entropy, where the forward and backward sequences of events are indistinguishable, such as colliding billiard balls in an equilibrium system.",
        "tags": [],
        "created": "2026-05-29T23:22:31.575Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Production Entropy",
        "type": "Concept",
        "description": "A measure of entropy generated during a thermodynamic process; if greater than zero, it indicates irreversibility in a nonequilibrium system.",
        "tags": [],
        "created": "2026-05-29T23:22:31.710Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Equilibrium System",
        "type": "Concept",
        "description": "A thermodynamic system in a state of balance where processes are reversible and do not produce net entropy, exemplified by the motion of colliding billiard balls.",
        "tags": [],
        "created": "2026-05-29T23:22:31.841Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Nonequilibrium System",
        "type": "Concept",
        "description": "A thermodynamic system characterized by irreversible changes and an increase in production entropy, such as a shattering glass, where the arrow of time is clearly distinguishable.",
        "tags": [],
        "created": "2026-05-29T23:22:32.013Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Billiard Balls",
        "type": "Concept",
        "description": "A classic physical example used to illustrate an equilibrium system and reversible processes, where forward and backward motion sequences are nearly identical.",
        "tags": [],
        "created": "2026-05-29T23:22:35.468Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Shattering Glass",
        "type": "Concept",
        "description": "A strong example of a nonequilibrium system and irreversible change, where the increase in entropy makes the reverse process (glass reassembling) impossible.",
        "tags": [],
        "created": "2026-05-29T23:22:35.592Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Hilgetag",
        "type": "Person",
        "description": "Researcher who co-authored a review critiquing the lack of rigorous definition of 'hierarchy' in neuroscience.",
        "tags": [],
        "created": "2026-05-29T23:23:45.337Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Goulas",
        "type": "Person",
        "description": "Researcher who co-authored a review with Hilgetag on the definition of hierarchy in neuroscience.",
        "tags": [],
        "created": "2026-05-29T23:23:48.865Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Topological Projection Sequences",
        "type": "Concept",
        "description": "One of the four main patterns identified by Hilgetag and Goulas to characterize brain hierarchy, referring to the sequential arrangement of neural projections.",
        "tags": [],
        "created": "2026-05-29T23:23:49.011Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Spatially Ordered Changes",
        "type": "Concept",
        "description": "One of the four main patterns identified by Hilgetag and Goulas to characterize brain hierarchy, also referred to as gradients of features across spatial dimensions.",
        "tags": [],
        "created": "2026-05-29T23:23:49.160Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Progression of Scales",
        "type": "Concept",
        "description": "One of the four main patterns identified by Hilgetag and Goulas to characterize brain hierarchy; proposed as the most fruitful approach for understanding hierarchical, multiscale organization.",
        "tags": [],
        "created": "2026-05-29T23:23:49.287Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Sorting of Laminar Projection Patterns",
        "type": "Concept",
        "description": "One of the four main patterns identified by Hilgetag and Goulas to characterize brain hierarchy, involving the organization of projections across cortical layers.",
        "tags": [],
        "created": "2026-05-29T23:23:49.411Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Connectional Sparsity",
        "type": "Concept",
        "description": "A property of global brain networks where connections are sparse, combined with network integration to capture hierarchical multiscale organization.",
        "tags": [],
        "created": "2026-05-29T23:23:49.539Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Network Integration",
        "type": "Concept",
        "description": "The process by which connectivity scales naturally from local to global levels, working in conjunction with connectional sparsity to define brain hierarchy.",
        "tags": [],
        "created": "2026-05-29T23:23:49.666Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Spacetime Hierarchical Scaling",
        "type": "Concept",
        "description": "A measure of brain hierarchy that captures organization over both space (from ion channels to large-scale networks) and time (temporal encapsulation of scales and rhythms).",
        "tags": [],
        "created": "2026-05-29T23:23:49.800Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Spatial Encapsulation",
        "type": "Concept",
        "description": "The hierarchical organization of brain structures over space, ranging from ion channels and dendritic spines to neurons, local cortical columns, and large-scale networks.",
        "tags": [],
        "created": "2026-05-29T23:23:49.933Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Temporal Encapsulation",
        "type": "Concept",
        "description": "The hierarchical organization of brain processes over time, involving the encapsulation of different time scales and rhythms.",
        "tags": [],
        "created": "2026-05-29T23:23:50.076Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Ion Channels",
        "type": "Concept",
        "description": "Microscopic structures involved in the spatial encapsulation of brain hierarchy, representing the smallest scale in the hierarchical organization from微观 to macro.",
        "tags": [],
        "created": "2026-05-29T23:23:50.205Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Dendritic Spines",
        "type": "Concept",
        "description": "Microscopic structures on neurons involved in the spatial encapsulation of brain hierarchy, representing a small scale in the hierarchical organization.",
        "tags": [],
        "created": "2026-05-29T23:23:50.332Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Local Cortical Column Circuits",
        "type": "Concept",
        "description": "Intermediate-scale neural structures composed of neurons, forming part of the spatial encapsulation in brain hierarchy between individual neurons and large-scale networks.",
        "tags": [],
        "created": "2026-05-29T23:23:50.465Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Large-scale Networks",
        "type": "Concept",
        "description": "Macroscopic neural structures representing the highest level of spatial encapsulation in the brain's hierarchical organization.",
        "tags": [],
        "created": "2026-05-29T23:23:50.600Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Global Workspace",
        "type": "Concept",
        "description": "A theoretical framework where information is integrated in a small group of brain regions before being broadcast to many other regions across the whole brain, orchestrating brain function.",
        "tags": [],
        "created": "2026-05-29T23:24:22.729Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Transfer Entropy",
        "type": "Concept",
        "description": "A generalized version of Granger causality used as a direct measure of hierarchy by estimating the information flow between brain signals.",
        "tags": [],
        "created": "2026-05-29T23:24:22.874Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Breaking the Detailed Balance",
        "type": "Concept",
        "description": "A thermodynamic measure of asymmetry in physical systems, used to define and quantify hierarchy by indicating deviation from equilibrium.",
        "tags": [],
        "created": "2026-05-29T23:24:28.278Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Prova d’orchestra",
        "type": "Concept",
        "description": "A film by Roberto Fellini used as a metaphorical example to illustrate the necessity of orchestration in hierarchical systems, akin to a conductor controlling an orchestra.",
        "tags": [],
