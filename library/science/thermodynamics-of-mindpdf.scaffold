      },
      {
        "name": "Visual Regions",
        "type": "Concept",
        "description": "Brain regions involved in processing visual stimuli during movie watching, part of the causal generator network.",
        "tags": [],
        "created": "2026-05-29T23:31:44.620Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Temporal Regions",
        "type": "Concept",
        "description": "Brain regions involved in processing auditory and temporal information during movie watching, part of the causal generator network.",
        "tags": [],
        "created": "2026-05-29T23:31:44.749Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Killingsworth",
        "type": "Person",
        "description": "Researcher who, along with Gilbert, studied the effects of mind-wandering and introspection on happiness, finding that resting is not always restful.",
        "tags": [],
        "created": "2026-05-29T23:31:44.892Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Gilbert",
        "type": "Person",
        "description": "Researcher who, along with Killingsworth, demonstrated that introspection and mind-wandering states rarely lead to a happy mind.",
        "tags": [],
        "created": "2026-05-29T23:31:45.022Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Thermodynamic Rat Race",
        "type": "Concept",
        "description": "A metaphorical description of the high-energy, high-irreversibility state of survival and demanding cognitive tasks, from which movie watching offers respite.",
        "tags": [],
        "created": "2026-05-29T23:31:45.162Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Audio-Visual Narrative",
        "type": "Concept",
        "description": "The structured stimulus provided by naturalistic films that requires minimal computation, offering a relaxing experience distinct from resting or task performance.",
        "tags": [],
        "created": "2026-05-29T23:31:45.294Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Turbulence",
        "type": "Concept",
        "description": "An irreversible dynamical regime taking place far from equilibrium, characterized by strong time asymmetry and spatiotemporal chaos. In the context of the brain, it facilitates efficient energy and information transfer across spatiotemporal scales, helping to overcome the slowness of local neuronal signals.",
        "tags": [],
        "created": "2026-05-29T23:32:29.114Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Leonardo da Vinci",
        "type": "Person",
        "description": "Historical figure who originally coined the term 'turbolenza' over half a millennium ago, initiating the conceptual study of turbulence.",
        "tags": [],
        "created": "2026-05-29T23:32:29.259Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Andrey Kolmogorov",
        "type": "Person",
        "description": "Mathematician who demonstrated the efficiency of turbulence by discovering a spatial power scaling law in fluid dynamics.",
        "tags": [],
        "created": "2026-05-29T23:32:29.392Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Spatial Power Scaling Law",
        "type": "Concept",
        "description": "A mathematical law discovered by Andrey Kolmogorov in fluid dynamics that describes the efficiency of turbulence, also found to be exhibited by brain dynamics.",
        "tags": [],
        "created": "2026-05-29T23:32:29.526Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Coupled Oscillators",
        "type": "Concept",
        "description": "Physical systems used to model the brain, where the level of turbulence varies between different brain states such as coma, sleep, and psychedelics.",
        "tags": [],
        "created": "2026-05-29T23:32:29.672Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Higher-Order Structure Functions",
        "type": "Concept",
        "description": "Mathematical functions providing recent evidence of turbulence in brain dynamics, demonstrating the presence of cascading information processing.",
        "tags": [],
        "created": "2026-05-29T23:32:39.690Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Spatiotemporal Chaos",
        "type": "Concept",
        "description": "A characteristic of turbulence in the brain that produces stochastic features often misclassified as noise, but which are inextricably bound to brain signals and facilitate efficient processing.",
        "tags": [],
        "created": "2026-05-29T23:32:39.828Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Information Flow",
        "type": "Concept",
        "tags": [],
        "created": "2026-05-29T23:32:39.919Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Fast Local Hippocampal Circuits",
        "type": "Concept",
        "description": "Specific neural circuits in the hippocampus where turbulence has been demonstrated, highlighting that turbulent dynamics occur not just in slow whole-brain networks but also in fast local processing units.",
        "tags": [],
        "created": "2026-05-29T23:33:13.655Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Cascaded Eddies",
        "type": "Concept",
        "description": "A physical phenomenon in fluid dynamics where large whirls turn into smaller whirls, eventually leading to energy dissation. In the brain, this concept is mapped to the cascading whirls of turbulence that facilitate efficient information transfer.",
        "tags": [],
        "created": "2026-05-29T23:33:18.482Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Energy Cascade",
        "type": "Concept",
        "description": "The process in turbulence where energy is transferred from large scales to smaller scales, resulting in excellent mixing capabilities and high efficiency across scales, described by a power law.",
        "tags": [],
        "created": "2026-05-29T23:33:18.617Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "High-Dimensional Spacetime Nonlinear Coupled Systems",
        "type": "Concept",
        "description": "The physical principles giving rise to turbulence, characterized by complex interactions in high-dimensional spacetime that result in the chaotic yet structured dynamics observed in fluids and brain activity.",
        "tags": [],
        "created": "2026-05-29T23:33:18.764Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Spatiotemporal Information Transfer",
        "type": "Concept",
        "description": "The efficient and fast movement of information across space and time in the brain, which is supported by the skeleton of turbulence and is required for survival.",
        "tags": [],
        "created": "2026-05-29T23:33:18.897Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Empirical Brain Dynamics",
        "type": "Concept",
        "description": "Observed brain activity patterns derived from real-world neuroimaging data, specifically from 1000 healthy participants in resting state, shown to exhibit turbulent characteristics.",
        "tags": [],
        "created": "2026-05-29T23:34:34.166Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Local Synchronisation Vortices",
        "type": "Concept",
        "description": "Highly variable, localized patterns of neural synchrony that occur across time and space in the turbulent brain regime, indicative of complex dynamic organization.",
        "tags": [],
        "created": "2026-05-29T23:34:34.316Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Hopf Whole-brain Models",
        "type": "Tool",
        "description": "Computational models based on Hopf bifurcation dynamics used to gain causal understanding of brain mechanisms by simultaneously fitting turbulence characteristics and empirical neuroimaging data at specific working points.",
        "tags": [],
        "created": "2026-05-29T23:34:41.302Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Surrogate Data",
        "type": "Concept",
        "description": "Artificially generated data sets carefully matched to empirical data properties but lacking specific dynamic structures, used as a control to demonstrate that turbulence is a genuine feature of brain activity and not a statistical artifact.",
        "tags": [],
        "created": "2026-05-29T23:34:45.157Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Neighbourhood-dependent Synchronisation",
        "type": "Concept",
        "description": "A dynamic process where synchronization of brain activity depends on the spatial proximity or connectivity of neural parcels, visualized through time-evolving plots of neighboring regions.",
        "tags": [],
        "created": "2026-05-29T23:34:45.378Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Albert Einstein",
        "type": "Person",
        "description": "Nobel Prize-winning physicist whose contributions to thermodynamics are considered seminal and relevant to the Thermodynamics of Mind framework, known for his work in relativity and quantum mechanics.",
        "tags": [],
        "created": "2026-05-29T23:34:49.801Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Erwin Schrödinger",
        "type": "Person",
        "description": "Nobel Prize-winning physicist whose work in thermodynamics and quantum mechanics, including the famous 'Schrödinger’s cat' paradox, provides historical inspiration for the Thermodynamics of Mind framework.",
        "tags": [],
        "created": "2026-05-29T23:34:49.933Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Schrödinger’s Cat",
        "type": "Concept",
        "description": "A famous thought experiment in quantum mechanics proposed by Erwin Schrödinger, illustrating the paradox of superposition where a cat can be considered simultaneously alive and dead, often discussed in the context of quantum interpretation debates.",
        "tags": [],
        "created": "2026-05-29T23:34:50.072Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Quantum Mechanics",
        "type": "Concept",
        "description": "A fundamental theory in physics describing the behavior of matter and energy at the atomic and subatomic levels, the interpretation of which was a subject of debate between Einstein and Schrödinger.",
        "tags": [],
        "created": "2026-05-29T23:34:50.211Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "What Is Life?",
        "type": "Product",
        "description": "An important book written by Erwin Schrödinger during his exile in Ireland, proposing that thermodynamics, specifically the arrow of time and non-reversibility, are crucial elements for sustaining life.",
        "tags": [],
        "created": "2026-05-29T23:35:22.419Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Metabolism",
        "type": "Concept",
        "description": "The technical term for the process by which living organisms avoid decay through eating, drinking, breathing, and assimilating, as described by Schrödinger in the context of thermodynamic sustainability of life.",
        "tags": [],
        "created": "2026-05-29T23:35:22.570Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Fluctuation-Dissipation Theorem",
        "type": "Concept",
        "description": "A thermodynamic concept (FDT) that describes the balancing forces of dissipation and spontaneous fluctuations, proposed as a candidate to quantify brain hierarchy and estimate the violation of FDT in different brain states.",
        "tags": [],
        "created": "2026-05-29T23:35:22.705Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Brownian Motion",
        "type": "Concept",
        "description": "A physical phenomenon describing the random motion of particles suspended in a fluid, theorized by Albert Einstein. It provides the historical and theoretical foundation for the Fluctuation-Dissipation Theorem.",
        "tags": [],
        "created": "2026-05-29T23:36:19.525Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Model-based Approaches",
        "type": "Concept",
        "description": "Analytical methods that rely on predefined theoretical models or simulations to interpret data, which can be combined with model-free approaches for a more comprehensive understanding of brain principles.",
        "tags": [],
        "created": "2026-05-29T23:36:37.118Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Low-dimensional Manifold of Brain Activity",
        "type": "Concept",
        "description": "A reduced-dimensional representation of complex brain dynamics that captures the essential structure of neural activity, allowing for the quantification of hierarchical changes over time.",
        "tags": [],
        "created": "2026-05-29T23:36:37.279Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Perturbative Principles",
        "type": "Concept",
        "description": "Methodological approaches involving the careful perturbation of a system to reveal its underlying causal mechanisms and dynamic properties, applicable to both physical systems and brain modeling.",
        "tags": [],
        "created": "2026-05-29T23:36:37.420Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Onsager’s Regression Principle",
        "type": "Concept",
        "description": "A thermodynamic principle stating that the relaxation of a system from a non-equilibrium state follows the same laws as the spontaneous fluctuations in equilibrium, providing a simple derivation for the Fluctuation-Dissipation Theorem.",
        "tags": [],
        "created": "2026-05-29T23:37:17.945Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "External Perturbation",
        "type": "Concept",
        "description": "An outside force or influence applied to a system to drive it from an initial equilibrium state to a final state, used in perturbative models to study system dynamics.",
        "tags": [],
        "created": "2026-05-29T23:37:24.309Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Spontaneous Equilibrium Fluctuation",
        "type": "Concept",
        "description": "Random variations that occur naturally in a system at equilibrium, which, according to Onsager’s principle, mirror the system's response to external perturbations.",
        "tags": [],
        "created": "2026-05-29T23:37:24.458Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Non-human Animals",
        "type": "Concept",
        "description": "Animal subjects used in thermodynamics-based whole-brain modeling, particularly under anaesthesia, to predict interventions for awakening and understand cross-species brain dynamics.",
        "tags": [],
        "created": "2026-05-29T23:37:24.600Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Depression",
        "type": "Concept",
        "description": "A neuropsychiatric condition characterized by specific hierarchical reconfigurations in the brain, which can be differentially affected by various pharmacological treatments.",
        "tags": [],
        "created": "2026-05-29T23:37:29.599Z",
        "source": "thermodynamics-of-mind.pdf"
      },
      {
        "name": "Pharmacological Treatments",
        "type": "Concept",
        "description": "Medical interventions using drugs to treat conditions like depression, which the Thermodynamics of Mind framework predicts will lead to distinct hierarchical reconfigations and varying efficacy or side effects.",
